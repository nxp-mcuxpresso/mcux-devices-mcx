# product related

config MCUX_HW_SOC_SERIES_MCX
    bool
    default y

config MCUX_HW_SOC_SINGLECORE_DEVICE
    bool
    default y

# core related

config MCUX_HW_CORE
    string
    default "cm23"

config MCUX_HW_CORE_CM23
    bool
    default y

config MCUX_HW_CORE_ID
    string
    default "cm23"

config MCUX_HW_CORE_ID_CM23
    bool
    default y

config MCUX_HW_DSP
    bool
    default n

config MCUX_HW_MPU
    bool
    default n

config MCUX_HW_FPU
    string
    default "NO_FPU"

config MCUX_HW_FPU_TYPE
    string
    default "no_fpu"

config MCUX_HW_NO_FPU
    bool
    default y

config MCUX_HW_INT_PRIO_BITS
    int
    default 2

config MCUX_HW_SAU
    bool
    default n

config MCUX_HW_INT_PRIO_BITS
    int
    default 2

# device related

config MCUX_HW_DEVICE_CORE
    string
    default "MCXC352"

config MCUX_HW_DEVICE_ID_MCXC352
    bool

choice MCUX_HW_DEVICE_PART_MCXC352
    prompt "Device MCXC352 Part"
    config MCUX_HW_DEVICE_PART_MCXC352GAMFM
    bool "MCXC352GAMFM"
    select MCUX_HW_DEVICE_ID_MCXC352
    config MCUX_HW_DEVICE_PART_MCXC352GAMFT
    bool "MCXC352GAMFT"
    select MCUX_HW_DEVICE_ID_MCXC352
    config MCUX_HW_DEVICE_PART_MCXC352MLF
    bool "MCXC352MLF"
    select MCUX_HW_DEVICE_ID_MCXC352
endchoice

config MCUX_HW_DEVICE_ID
    string
    default "MCXC352" if MCUX_HW_DEVICE_ID_MCXC352

config MCUX_HW_DEVICE_PART
    string
    default "MCXC352GAMFM" if MCUX_HW_DEVICE_PART_MCXC352GAMFM
    default "MCXC352GAMFT" if MCUX_HW_DEVICE_PART_MCXC352GAMFT
    default "MCXC352MLF" if MCUX_HW_DEVICE_PART_MCXC352MLF

# For chipmodel generated files
config MCUX_TOOLCHAIN_LINKER_DEVICE_PREFIX
    string
    default "MCXC352" if MCUX_HW_DEVICE_ID_MCXC352

config MCUX_TOOLCHAIN_MCUX_STARTUP
    string
    default "mcxc352"

# Toolchain related

config MCUX_TOOLCHAIN_IAR_CPU_IDENTIFIER
    string
    default "MCXC352" if MCUX_HW_DEVICE_ID_MCXC352

config MCUX_TOOLCHAIN_MDK_CPU_IDENTIFIER
    string
    default "MCXC352GAMFM" if MCUX_HW_DEVICE_PART_MCXC352GAMFM
    default "MCXC352GAMFT" if MCUX_HW_DEVICE_PART_MCXC352GAMFT
    default "MCXC352MLF" if MCUX_HW_DEVICE_PART_MCXC352MLF

config MCUX_TOOLCHAIN_JLINK_CPU_IDENTIFIER
    string
    default "MCXC352" if MCUX_HW_DEVICE_ID_MCXC352

